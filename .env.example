# Copy to .env and fill in: `make env` does the copy and generates the secrets.
# .env is gitignored. Nothing in here is safe to commit once filled.
#
# docker compose reads this file directly, so it is both the application's
# config and the stack's.

# --- Dataset -----------------------------------------------------------------
# Obtain the token by registering at https://docile.rossum.ai/
#
# This token is a live credential: the download script interpolates it directly
# into the S3 URL path (https://docile-dataset-rossum.s3.../$TOKEN/$zipfile),
# so anyone who has it can pull the dataset.
DOCILE_TOKEN=

# Where the extracted dataset lives, relative to the repo root.
DOCILE_ROOT=data/docile

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=assay
POSTGRES_PASSWORD=
POSTGRES_DB=assay
POSTGRES_PORT=5432

# The second database on the same server, for Langfuse.
LANGFUSE_DB=langfuse

# Host-side connection string. Inside compose, services use `postgres:5432`.
DATABASE_URL=postgresql://assay:${POSTGRES_PASSWORD}@localhost:5432/assay

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_PORT=6379

# db 0 is Langfuse's ingestion queue; the application uses db 1 to keep the
# two from sharing a keyspace.
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/1

# --- Langfuse ----------------------------------------------------------------
# Self-hosted, at http://localhost:3000. First login uses the INIT_USER
# credentials below.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PORT=3000

# Project API keys. These are provisioned into Langfuse on first boot rather
# than read out of the UI afterwards, so any value works as long as the SDK and
# the server agree on it — which they do, since both read it from here.
LANGFUSE_PUBLIC_KEY=pk-lf-0000000000000000000000000000000000
LANGFUSE_SECRET_KEY=

# 32-byte hex. `openssl rand -hex 32`
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_SECRET=

LANGFUSE_INIT_USER_EMAIL=dev@localhost
LANGFUSE_INIT_USER_NAME=dev
LANGFUSE_INIT_USER_PASSWORD=

# Langfuse phones home with anonymous usage stats unless this is false.
LANGFUSE_TELEMETRY_ENABLED=false

# --- Langfuse's backing services ---------------------------------------------
# Not the application's — it talks to neither. Langfuse v4 stores traces in
# ClickHouse and event payloads in S3, with MinIO standing in for S3 locally.
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=

# --- Model serving -----------------------------------------------------------
# vLLM, OpenAI-compatible. The extraction stage sends `guided_json` with the
# schema from `assay.schema.invoice.invoice_json_schema()`.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# Per-field logprobs are what the confidence gate scores, so the server must be
# started with logprobs enabled and the client must ask for them.
VLLM_LOGPROBS=true

# --- Confidence gate ---------------------------------------------------------
# Fields scoring below this route to human review instead of being accepted.
# Calibrate against the eval set rather than trusting this default.
ASSAY_CONFIDENCE_THRESHOLD=0.85
